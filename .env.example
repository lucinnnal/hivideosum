# ---------- YouTube collection (optional proxy) ----------
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# Or generic proxy:
# TRANSCRIPT_HTTP_PROXY=
# TRANSCRIPT_HTTPS_PROXY=

# ---------- Vertex AI Gemini (filter step) ----------
GOOGLE_GENAI_USE_VERTEXAI=True
GCP_PROJECT=hivideosum
GCP_LOCATION=global
# Local dev: rely on `gcloud auth application-default login`
# Docker / prod: mount service account JSON and set:
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/sa.json
# GOOGLE_SA_PATH=/absolute/host/path/to/sa.json

# ---------- vLLM (summary step) ----------
VLLM_BASE_URL=http://vllm:8001/v1
VLLM_MODEL_NAME=hivideosum
VLLM_API_KEY=dummy

# ---------- Infra ----------
REDIS_URL=redis://redis:6379/0

# ---------- API behavior ----------
API_HOST=0.0.0.0
API_PORT=8000
RESULT_TTL_SECONDS=86400
COLLECT_MAX_REGULAR=50
COLLECT_MAX_TIMESTAMP=50
